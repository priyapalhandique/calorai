# Copy this file to `.env` and fill in your FortyGuard API key.
# The notebooks load this automatically via python-dotenv.

FORTYGUARD_API_KEY=your_api_key_here

# Optional — override the default production base URL.
# Development: https://tos-enterprise-api.dev.app.fortyguard.com
# Production:  https://api.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Optional — Exa web search for gated enrichment (VoxMind-style nearest bus stop, cooling center).
# Get a free key at https://exa.ai → Dashboard → API Keys. Mock tests stay mock when absent.
EXA_API_KEY=your_exa_api_key_here
